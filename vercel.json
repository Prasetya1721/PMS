{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "node build-vercel.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?__pms_route="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__pms_route=$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
