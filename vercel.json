{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js?__pms_route="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__pms_route=$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
